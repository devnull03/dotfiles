[Unit]
Description=Mount Google Drive School folder at ~/School
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
ExecStartPre=/usr/bin/mkdir -p %h/School
# School folder lives under Computers > My Laptop (Windows backup), so it is reached by folder ID.
ExecStart=/usr/bin/rclone mount gdrive: %h/School \
  --drive-root-folder-id 1BAYjJlA4hkIxgeFqEN44SBcoJ0y9LAS1 \
  --vfs-cache-mode full \
  --vfs-cache-max-age 720h \
  --dir-cache-time 5m \
  --poll-interval 1m
ExecStop=/usr/bin/fusermount3 -u %h/School
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
