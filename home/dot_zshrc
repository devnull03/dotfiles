# Ported from the live Debian WSL ~/.zshrc.
export ZSH="$HOME/.local/share/cachyos-dotfiles/oh-my-zsh"
export ZSH_CUSTOM="$HOME/.config/omz-custom"
ZSH_THEME="jovial"
plugins=(git urltools jovial rust python)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit && compinit
  print -u2 'Run the CachyOS dotfiles bootstrap to install Oh My Zsh.'
fi

# The same third-party plugins as Debian, installed at pinned revisions.
# fzf-tab must load after compinit (Oh My Zsh) and before the widget wrappers.
for plugin_file in \
  fzf-tab/fzf-tab.plugin.zsh \
  zsh-autosuggestions/zsh-autosuggestions.zsh \
  fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh \
  zsh-history-enquirer/zsh-history-enquirer.plugin.zsh; do
  [[ -r "$HOME/.local/share/cachyos-dotfiles/plugins/$plugin_file" ]] &&
    source "$HOME/.local/share/cachyos-dotfiles/plugins/$plugin_file"
done
unset plugin_file

export EDITOR=nvim
export VISUAL="$EDITOR"
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/.bun/bin" $path)
export BUN_INSTALL="$HOME/.bun"
alias vi="$EDITOR"
alias vim="$EDITOR"
alias zshrc='$EDITOR ~/.zshrc'
alias reload-zsh='source ~/.zshrc'
alias ohmyzsh='$EDITOR "$ZSH"'
alias cls='clear && ls'
alias wm=workmux

[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
if (( $+commands[uv] )); then
  eval "$(uv generate-shell-completion zsh)"
fi
if (( $+commands[uvx] )); then
  eval "$(uvx --generate-shell-completion zsh)"
fi
bindkey -v
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi
# Keep Debian's final Ctrl+R/history and file-navigation bindings.
if (( $+commands[fzf] )); then
  eval "$(fzf --zsh)"
fi

# fzf-tab: previews for cd/zoxide completions.
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':fzf-tab:complete:(cd|__zoxide_z):*' fzf-preview 'eza -1 --color=always --icons $realpath'

# Modern replacements, only when installed.
if (( $+commands[eza] )); then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -lh --icons --git --group-directories-first'
  alias la='eza -lah --icons --git --group-directories-first'
  alias lt='eza --tree --level=2 --icons'
fi
(( $+commands[bat] )) && alias cat='bat --paging=never --style=plain'
(( $+commands[lazygit] )) && alias lg=lazygit

# yazi: `y` opens yazi and cds into the directory you quit in.
if (( $+commands[yazi] )); then
  function y() {
    local tmp="$(mktemp -t yazi-cwd.XXXXXX)" cwd
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [[ -n "$cwd" && "$cwd" != "$PWD" ]] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
  }
fi

# atuin: searchable shell history on Ctrl+R (loaded last so it owns Ctrl+R);
# Up arrow keeps normal per-session history.
if (( $+commands[atuin] )); then
  eval "$(atuin init zsh --disable-up-arrow)"
fi
