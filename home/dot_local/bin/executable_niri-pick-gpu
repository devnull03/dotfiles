#!/usr/bin/env bash
# Runs before niri starts (systemd drop-in niri.service.d/gpu.conf).
# If any monitor is plugged into the NVIDIA dGPU's port, render on the dGPU so that
# monitor gets frames directly instead of a cross-GPU copy (smoother). Otherwise
# render on the AMD iGPU and make niri ignore the dGPU entirely: just holding it open
# keeps it out of runtime D3 (~10 W on battery). Re-login after (un)plugging.
set -euo pipefail
out="${XDG_CONFIG_HOME:-$HOME/.config}/niri/cfg/gpu.kdl"
nv_pci="pci-0000:01:00.0"
# The nvidia module sometimes loads ~10 s after niri starts; without its nodes we
# can't ignore them and niri grabs the dGPU when it appears, so wait for them.
if [ -e /sys/bus/pci/devices/0000:01:00.0 ]; then
    udevadm wait --timeout=20 "/dev/dri/by-path/$nv_pci-card" "/dev/dri/by-path/$nv_pci-render" 2>/dev/null || true
fi
card="$(readlink -e "/dev/dri/by-path/$nv_pci-card" 2>/dev/null || true)"
render="$(readlink -e "/dev/dri/by-path/$nv_pci-render" 2>/dev/null || true)"

connected=false
if [ -n "$card" ] && [ -n "$render" ]; then
    for s in /sys/class/drm/"$(basename "$card")"-*/status; do
        [ "$(cat "$s" 2>/dev/null)" = connected ] && connected=true
    done
fi

{
    echo "// Generated by niri-pick-gpu at session start; do not edit."
    if $connected; then
        printf 'debug {\n    render-drm-device "%s"\n}\n' "$render"
    else
        echo "// No monitor on the NVIDIA GPU: render on the AMD iGPU, leave the dGPU alone so it sleeps."
        if [ -n "$card" ] && [ -n "$render" ]; then
            printf 'debug {\n    ignore-drm-device "%s"\n    ignore-drm-device "%s"\n}\n' "$card" "$render"
        fi
    fi
} >"$out.tmp"
mv "$out.tmp" "$out"
