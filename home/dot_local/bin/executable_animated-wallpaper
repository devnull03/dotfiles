#!/usr/bin/env bash
# Animated (video) wallpaper via mpvpaper, layered above Noctalia's static wallpaper.
#
#   animated-wallpaper            random clip from $ANIMWALL_DIR
#   animated-wallpaper FILE       play FILE (mp4/webm/gif)
#   animated-wallpaper stop       kill it; Noctalia's static wallpaper shows again
#   animated-wallpaper toggle     start if stopped, stop if running
#   animated-wallpaper pick       choose a clip in a Vicinae list (with preview)
#
# Battery-conscious defaults:
#   - decodes on the AMD iGPU (VAAPI, renderD128) so the NVIDIA dGPU can stay asleep
#   - no audio, auto-pauses while fully covered (-p), no software filters (keeps hwdec)
#   - on battery it does NOT start unless ANIMWALL_ON_BATTERY=1
set -euo pipefail

dir="${ANIMWALL_DIR:-$HOME/Pictures/gif wallpapers}"
output="${ANIMWALL_OUTPUT:-ALL}"

on_battery() {
    for s in /sys/class/power_supply/*/online; do
        [ "$(cat "$s" 2>/dev/null)" = 1 ] && return 1
    done
    return 0
}

stop() { pkill -x mpvpaper 2>/dev/null || true; }

case "${1:-}" in
    stop) stop; exit 0 ;;
    pick)
        choice="$(find "$dir" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \) | sort \
            | vicinae dmenu -n "Animated wallpaper" -p "Search clips…")" || exit 0
        [ -n "$choice" ] || exit 0
        set -- "$choice" ;;
    toggle)
        if pgrep -x mpvpaper >/dev/null; then stop; exit 0; fi
        shift ;;
esac

if on_battery && [ "${ANIMWALL_ON_BATTERY:-0}" != 1 ] && [ -z "${1:-}" ]; then
    echo "animated-wallpaper: on battery, skipping (set ANIMWALL_ON_BATTERY=1 to force)" >&2
    exit 0
fi

file="${1:-}"
if [ -z "$file" ]; then
    file="$(find "$dir" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' \) | shuf -n1)"
fi
[ -f "$file" ] || { echo "animated-wallpaper: no video found ($dir)" >&2; exit 1; }

stop
mpv_opts="no-audio loop hwdec=vaapi vaapi-device=/dev/dri/renderD128 panscan=1.0 profile=fast"

# "bottom" layer sits above Noctalia's background-layer wallpaper but below windows.
setsid -f mpvpaper -p -l bottom -o "$mpv_opts" "$output" "$file" >/dev/null 2>&1
