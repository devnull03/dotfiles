#!/usr/bin/env python3
"""Pause mpvpaper unless the wallpaper is actually visible and we're on AC.

Plays only when: on AC power AND at least one output's active workspace has no
windows. Otherwise pauses via mpvpaper's mpv IPC socket (started by noctalia).
"""
import glob, json, os, select, socket, subprocess, time

SOCK_GLOB = os.path.expanduser("~/.local/state/noctalia/mpvpaper/ipc-*.sock")
AC = "/sys/class/power_supply/AC0/online"
POLL = 15  # seconds; re-check battery / new sockets even with no niri events


def niri(*args):
    return json.loads(subprocess.check_output(["niri", "msg", "--json", *args]))


def on_ac():
    try:
        return open(AC).read().strip() == "1"
    except OSError:
        return True


def wallpaper_visible():
    ws = niri("workspaces")
    occupied = {w["workspace_id"] for w in niri("windows") if w.get("workspace_id")}
    return any(w["is_active"] and w["id"] not in occupied for w in ws)


def set_pause(paused):
    msg = json.dumps({"command": ["set_property", "pause", paused]}).encode() + b"\n"
    for path in glob.glob(SOCK_GLOB):
        try:
            with socket.socket(socket.AF_UNIX) as s:
                s.settimeout(1)
                s.connect(path)
                s.sendall(msg)
        except OSError:
            pass


def update():
    try:
        set_pause(not (on_ac() and wallpaper_visible()))
    except Exception as e:
        print("update failed:", e, flush=True)


def main():
    while True:
        proc = subprocess.Popen(["niri", "msg", "--json", "event-stream"],
                                stdout=subprocess.PIPE, text=True)
        update()
        while proc.poll() is None:
            r, _, _ = select.select([proc.stdout], [], [], POLL)
            if r and not proc.stdout.readline():
                break
            update()
        proc.kill()
        time.sleep(2)


if __name__ == "__main__":
    main()
